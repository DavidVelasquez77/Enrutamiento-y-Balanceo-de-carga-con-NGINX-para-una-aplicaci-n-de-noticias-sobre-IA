<!DOCTYPE html>
<html lang="es">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="<%= noticia.resumen %>"
  >

  <title>
    <%= noticia.titulo %> | INTER Tech News
  </title>

  <link
    rel="stylesheet"
    href="/css/styles.css"
  >

</head>

<body>


  <header class="site-header">

    <div class="top-header">

      <a href="/" class="logo">
        <span>INTER</span>
        TECH NEWS
      </a>

      <div class="academic-label">
        Proyecto académico / IA
      </div>

    </div>


    <nav class="main-nav">

      <a href="/">Inicio</a>
      <span>Inteligencia Artificial</span>
      <span>Ciberseguridad</span>
      <span>Cloud</span>
      <span>Robótica</span>
      <span>Software</span>

    </nav>

  </header>


  <main class="page-container">

    <article class="article-page">


      <a
        href="/"
        class="article-back"
      >
        ← Volver a noticias
      </a>


      <header class="article-heading">

        <span class="category-label">
          <%= noticia.categoria %>
        </span>


        <h1>
          <%= noticia.titulo %>
        </h1>


        <p class="article-date">
          Publicado el <%= noticia.fecha %>
        </p>

      </header>


      <img
        class="article-main-image"
        src="<%= noticia.imagen %>"
        alt="<%= noticia.titulo %>"
      >


      <section class="article-lead">

        <h2>
          Resumen
        </h2>

        <p>
          <%= noticia.resumen %>
        </p>

      </section>


      <section class="article-body">

        <% noticia.contenido
          .trim()
          .split('\n\n')
          .forEach((parrafo) => { %>

            <p>
              <%= parrafo.trim() %>
            </p>

        <% }); %>

      </section>


      <section class="article-attribution">

        <p>
          <strong>Fuente del texto:</strong>
          <%= noticia.ia %>
        </p>

        <p>
          <strong>Aviso académico:</strong>
          este artículo fue elaborado con fines educativos.
          El contenido generado o asistido mediante inteligencia
          artificial no debe considerarse información
          periodística verificada.
        </p>

      </section>

    </article>

  </main>


  <footer class="site-footer">

    <div>

      <div class="footer-logo">
        INTER <span>TECH NEWS</span>
      </div>

      <p>
        Portal académico sobre tecnología e inteligencia artificial.
      </p>

    </div>


    <div class="footer-meta">

      <div class="instance-indicator">
        Instancia:
        <strong><%= instanceName %></strong>
      </div>

      <p>
        Contenido generado o asistido con ChatGPT.
      </p>

      <p>
        Proyecto académico — 2026
      </p>

    </div>

  </footer>


</body>

</html>