<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Página no encontrada | Nexus Tech News</title>

  <link
    rel="stylesheet"
    href="/css/styles.css"
  >
</head>

<body>

  <header class="site-header">

    <div class="top-header">

      <a href="/" class="logo">
        <span>NEXUS</span>
        TECH NEWS
      </a>

      <div class="academic-label">
        Proyecto académico / IA
      </div>

    </div>

    <nav class="main-nav">
      <a href="/">Inicio</a>
      <span>Inteligencia Artificial</span>
      <span>Ciberseguridad</span>
      <span>Cloud</span>
      <span>Robótica</span>
      <span>Videojuegos</span>
      <span>Software</span>
    </nav>

  </header>


  <main class="page-container">

    <section class="error-page">

      <p class="error-code">
        404
      </p>

      <p class="category-label">
        Página no encontrada
      </p>

      <h1>
        La página que buscas no existe.
      </h1>

      <p class="error-description">
        La dirección solicitada no corresponde a una noticia
        o sección disponible en Nexus Tech News.
      </p>

      <a
        href="/"
        class="editorial-link"
      >
        Volver al inicio
        <span>→</span>
      </a>

    </section>

  </main>


  <footer class="site-footer">

    <div>

      <div class="footer-logo">
        NEXUS <span>TECH NEWS</span>
      </div>

      <p>
        Portal académico sobre tecnología e inteligencia artificial.
      </p>

    </div>


    <div class="footer-meta">

      <div class="instance-indicator">
        Instancia:
        <strong><%= instanceName %></strong>
      </div>

      <p>
        Contenido generado o asistido con ChatGPT.
      </p>

      <p>
        Proyecto académico — 2026
      </p>

    </div>

  </footer>

</body>

</html>