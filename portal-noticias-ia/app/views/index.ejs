<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="Portal académico de noticias sobre tecnología e inteligencia artificial."
  >

  <title>Nexus Tech News</title>

  <link
    rel="stylesheet"
    href="/css/styles.css"
  >
</head>

<body>

  <!-- CABECERA -->
  <header class="site-header">

    <div class="top-header">

      <a href="/" class="logo">
        <span>NEXUS</span>
        TECH NEWS
      </a>

      <div class="academic-label">
        Proyecto académico / IA
      </div>

    </div>

    <nav class="main-nav">

      <a href="/">Inicio</a>
      <span>Inteligencia Artificial</span>
      <span>Ciberseguridad</span>
      <span>Cloud</span>
      <span>Robótica</span>
      <span>Videojuegos</span>
      <span>Software</span>

    </nav>

  </header>


  <main class="page-container">

    <!-- AVISO ACADÉMICO -->
    <section class="academic-notice">

      <span class="notice-marker">
        IA
      </span>

      <p>
        <strong>
          Contenido académico generado o asistido mediante
          inteligencia artificial.
        </strong>

        Los artículos han sido revisados con fines educativos
        y no deben considerarse información periodística verificada.
      </p>

    </section>


    <!-- PORTADA PRINCIPAL -->
    <section class="lead-layout">

      <!-- NOTICIA PRINCIPAL -->
      <article class="lead-story">

        <div class="story-meta">

          <span class="category-label">
            <%= noticias[0].categoria %>
          </span>

          <span>
            <%= noticias[0].fecha %>
          </span>

        </div>


        <h1>
          <%= noticias[0].titulo %>
        </h1>


        <p class="lead-summary">
          <%= noticias[0].resumen %>
        </p>


        <a href="/noticias/<%= noticias[0].id %>">

          <img
            class="lead-image"
            src="<%= noticias[0].imagen %>"
            alt="<%= noticias[0].titulo %>"
          >

        </a>


        <div class="story-footer">

          <p>
            <strong>Fuente:</strong>
            <%= noticias[0].ia %>
          </p>


          <a
            href="/noticias/<%= noticias[0].id %>"
            class="editorial-link"
          >
            Leer artículo
            <span>→</span>
          </a>

        </div>

      </article>


      <!-- NOTICIAS SECUNDARIAS 2, 3 Y 4 -->
      <aside class="secondary-stories">

        <% noticias.slice(1, 4).forEach((noticia) => { %>

          <article class="secondary-story">

            <a href="/noticias/<%= noticia.id %>">

              <img
                class="secondary-image"
                src="<%= noticia.imagen %>"
                alt="<%= noticia.titulo %>"
                loading="lazy"
              >

            </a>


            <div class="secondary-content">

              <div class="story-meta">

                <span class="category-label">
                  <%= noticia.categoria %>
                </span>

                <span>
                  <%= noticia.fecha %>
                </span>

              </div>


              <h2>

                <a href="/noticias/<%= noticia.id %>">
                  <%= noticia.titulo %>
                </a>

              </h2>


              <p>
                <%= noticia.resumen %>
              </p>


              <a
                href="/noticias/<%= noticia.id %>"
                class="editorial-link"
              >
                Leer más
                <span>→</span>
              </a>

            </div>

          </article>

        <% }); %>

      </aside>

    </section>


    <!-- TITULO DE SEGUNDA SECCIÓN -->
    <div class="section-title">

      <span>05</span>

      <h2>
        Más historias
      </h2>

    </div>


    <!-- NOTICIAS 5 Y 6 -->
    <section class="more-stories">

      <% noticias.slice(4).forEach((noticia) => { %>

        <article class="horizontal-story">

          <a href="/noticias/<%= noticia.id %>">

            <img
              class="horizontal-image"
              src="<%= noticia.imagen %>"
              alt="<%= noticia.titulo %>"
              loading="lazy"
            >

          </a>


          <div class="horizontal-content">

            <div class="story-meta">

              <span class="category-label">
                <%= noticia.categoria %>
              </span>

              <span>
                <%= noticia.fecha %>
              </span>

            </div>


            <h2>

              <a href="/noticias/<%= noticia.id %>">
                <%= noticia.titulo %>
              </a>

            </h2>


            <p>
              <%= noticia.resumen %>
            </p>


            <div class="story-footer">

              <p>
                <strong>Fuente:</strong>
                <%= noticia.ia %>
              </p>


              <a
                href="/noticias/<%= noticia.id %>"
                class="editorial-link"
              >
                Leer artículo
                <span>→</span>
              </a>

            </div>

          </div>

        </article>

      <% }); %>

    </section>

  </main>


  <!-- FOOTER -->
  <footer class="site-footer">

    <div>

      <div class="footer-logo">
        NEXUS <span>TECH NEWS</span>
      </div>

      <p>
        Portal académico sobre tecnología e inteligencia artificial.
      </p>

    </div>


    <div class="footer-meta">

      <p>
        Contenido generado o asistido con ChatGPT.
      </p>

      <p>
        Proyecto académico — 2026
      </p>

    </div>

  </footer>

</body>

</html>